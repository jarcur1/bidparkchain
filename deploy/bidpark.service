# systemd unit for the hosted staging API + web app (testnet only).
# sudo cp deploy/bidpark.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now bidpark
[Unit]
Description=BidPark staging (Sepolia testnet)
After=network-online.target
Wants=network-online.target

[Service]
User=bidpark
WorkingDirectory=/opt/bidpark/current
# Secrets and settings; readable only by root and the bidpark user (chmod 640). Never commit this file.
EnvironmentFile=/etc/bidpark/bidpark.env
ExecStart=/usr/bin/node server/index.mjs
# SIGTERM drains in-flight requests and the index job before the database closes.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bidpark
PrivateTmp=true

[Install]
WantedBy=multi-user.target
