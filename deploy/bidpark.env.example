# Copy to /etc/bidpark/bidpark.env (chmod 640, owner root:bidpark). Never commit the real file.
BIDPARK_PROFILE=sepolia
# Persistent data (deployment.json, bidpark-sepolia.db, photos/, backups). Must survive deploys and restarts.
BIDPARK_DATA_DIR=/var/lib/bidpark
# Server-side RPC with finalized + historical reads. Contains a credential: keep it out of VITE_* and logs.
BIDPARK_SEPOLIA_RPC_URL=https://<provider>/<key>
# Built web app served from the same origin as /api.
BIDPARK_WEB_DIR=/opt/bidpark/current/dist
# Exact public origin(s) of the site; turns on hosted-mode origin checks and write limits.
BIDPARK_ALLOWED_ORIGINS=https://staging.bidpark.example
# Caddy runs on the same host, so trust it for client IP and https.
BIDPARK_TRUST_PROXY=loopback
BIDPARK_HOST=127.0.0.1
PORT=3001
BIDPARK_WRITES_PER_MINUTE=60
BIDPARK_RPC_TIMEOUT_MS=10000
# Readiness fails if the event index falls this many finalized blocks behind.
BIDPARK_MAX_INDEX_LAG=64
# Required for private arrival instructions: 32 random bytes as 64 hex characters, for example
# from `openssl rand -hex 32`. Without it the API refuses to save instructions in hosted mode.
# Keep it outside the database and its backups. See docs/hosting.md#arrival-instruction-encryption.
BIDPARK_ARRIVAL_KEY=<64 hex characters>
# Required for one-use arrival codes: a separate 32-byte HMAC key (64 hex characters). Without it the API
# refuses to issue or verify codes in hosted mode; locally it signs with a key that lasts until restart.
# Changing it invalidates codes already issued (they live 5 minutes).
BIDPARK_ARRIVAL_TOKEN_KEY=<64 hex characters>
# Uploaded photo limits (defaults shown): photos kept per wallet, total storage in MB, hours an unreferenced
# photo is kept before the sweep deletes it, and minutes between sweeps. See docs/hosting.md#host-workspace.
#BIDPARK_PHOTO_MAX_PER_WALLET=20
#BIDPARK_PHOTO_STORAGE_MB=200
#BIDPARK_PHOTO_GRACE_HOURS=24
#BIDPARK_PHOTO_SWEEP_MINUTES=60
# Optional automatic settlement (off by default). Use a dedicated, lightly funded keeper key, never
# the deployer key or a demo account; the API refuses both. See docs/hosting.md#automatic-settlement.
#BIDPARK_SETTLEMENT=1
#BIDPARK_KEEPER_KEY=0x<dedicated keeper private key>
#BIDPARK_SETTLEMENT_INTERVAL_MS=30000
# Do NOT set BIDPARK_SEPOLIA_DEPLOYER_KEY here; it is only injected for `npm run deploy -- --create`.
