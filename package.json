{
  "name": "bidpark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "chain": "hardhat node --hostname 127.0.0.1",
    "deploy": "node scripts/deploy.mjs",
    "demo": "node scripts/demo.mjs",
    "backup": "node scripts/backup.mjs",
    "api": "node server/index.mjs",
    "start": "node server/index.mjs",
    "web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src server shared scripts tests",
    "test": "vitest run && npm run test:seed",
    "test:ui": "vitest run --project ui",
    "test:contracts": "vitest run --project contracts",
    "test:gas": "node tests/gas/gas-snapshot.mjs",
    "gas:snapshot": "node tests/gas/gas-snapshot.mjs update",
    "test:api": "vitest run --project api && npm run test:seed",
    "test:seed": "node --test tests/seed-recovery.test.mjs",
    "test:e2e": "playwright test",
    "health": "node scripts/health.mjs"
  },
  "dependencies": {
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "solc": "0.8.38"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/leaflet": "^1.9.20",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "hardhat": "^3.22.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
